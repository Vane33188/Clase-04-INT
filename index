o": "Lina", "Ventas": 9441530676, "Ingresos": 1567326476, "N": 182, "Margen": 16.6}, {"Empleado": "Paola", "Ventas": 9219121203, "Ingresos": 1481243243, "N": 168, "Margen": 16.1}], "area": [{"Area": "Compras", "Ventas": 22396562530}, {"Area": "Ventas", "Ventas": 19681851267}, {"Area": "Almacen", "Ventas": 11001412676}, {"Area": "Gerencia", "Ventas": 10813613563}, {"Area": "Control de calidad", "Ventas": 10746481941}, {"Area": "Administracion", "Ventas": 10489264790}, {"Area": "Despachos", "Ventas": 9457100593}, {"Area": "Logística", "Ventas": 9219121203}]}</script>
<script>
const D = JSON.parse(document.getElementById('data-json').textContent);
const fmtM = n => (n/1e6).toLocaleString('es-CO',{maximumFractionDigits:0}) + 'M';
const fmt0 = n => Math.round(n).toLocaleString('es-CO');
const fmtPct = n => n.toLocaleString('es-CO',{maximumFractionDigits:1}) + '%';

Chart.defaults.font.family = "'Inter', sans-serif";
Chart.defaults.color = '#9aa3b2';
Chart.defaults.borderColor = '#2a303c';

// KPIs
const kpiGrid = document.getElementById('kpiGrid');
const kpis = [
  {l:'Ventas totales', v:'$'+fmtM(D.kpi.ventas_total), n:D.kpi.n_trans+' transacciones', accent:true},
  {l:'Margen bruto', v:'$'+fmtM(D.kpi.ingresos_total), n:fmtPct(D.kpi.margen_pct)+' sobre ventas'},
  {l:'Ticket promedio', v:'$'+fmtM(D.kpi.ticket_prom), n:'por venta'},
  {l:'Clientes activos', v:D.kpi.clientes, n:D.kpi.productos+' productos en catálogo'},
];
kpiGrid.innerHTML = kpis.map(k=>`<div class="kpi ${k.accent?'accent':''}"><div class="label">${k.l}</div><div class="value">${k.v}</div><div class="note">${k.n}</div></div>`).join('');

document.getElementById('pendienteTxt').textContent = fmtPct(D.tendencia_ventas_pct_mensual);

// Tablas y ratios: no dependen de Chart.js, se pintan siempre.
// Tabla marca
const maxMargen = Math.max(...D.marca.map(m=>m.Margen));
document.getElementById('tablaMarca').innerHTML = `<table><thead><tr><th>Marca</th><th class="num">Ventas</th><th class="num">Margen</th></tr></thead><tbody>
${D.marca.map(m=>`<tr><td>${m.Marca}</td><td class="num">$${fmtM(m.Ventas)}</td><td class="num"><div class="bar-cell" style="justify-content:flex-end"><span>${fmtPct(m.Margen)}</span><div class="bar-track" style="max-width:70px"><div class="bar-fill" style="width:${m.Margen/maxMargen*100}%"></div></div></div></td></tr>`).join('')}
</tbody></table>`;

// Tabla productos
const maxProd = Math.max(...D.top_productos.map(p=>p.Ventas));
document.getElementById('tablaProductos').innerHTML = `<table><thead><tr><th>Producto</th><th class="num">Unidades</th><th class="num">Ventas</th><th>Participación</th></tr></thead><tbody>
${D.top_productos.map(p=>`<tr><td>${p.Producto}</td><td class="num">${fmt0(p.Cant)}</td><td class="num">$${fmtM(p.Ventas)}</td><td><div class="bar-cell"><div class="bar-track"><div class="bar-fill" style="width:${p.Ventas/maxProd*100}%"></div></div></div></td></tr>`).join('')}
</tbody></table>`;

// Tabla empleados
const maxEmp = Math.max(...D.empleados.map(e=>e.Ventas));
document.getElementById('tablaEmpleados').innerHTML = `<table><thead><tr><th>Vendedor</th><th class="num">Ventas</th><th class="num">Margen generado</th><th class="num">Nº ventas</th><th>Participación</th></tr></thead><tbody>
${D.empleados.map(e=>`<tr><td>${e.Empleado}</td><td class="num">$${fmtM(e.Ventas)}</td><td class="num">$${fmtM(e.Ingresos)}</td><td class="num">${e.N}</td><td><div class="bar-cell"><div class="bar-track"><div class="bar-fill" style="width:${e.Ventas/maxEmp*100}%"></div></div></div></td></tr>`).join('')}
</tbody></table>`;

// Ratios
const ventasTotal = D.kpi.ventas_total, ingresosTotal = D.kpi.ingresos_total;
const costoTotal = ventasTotal - ingresosTotal;
const rotacion = (ventasTotal/costoTotal).toFixed(2);
const topClientePct = Math.max(...D.clientes.map(c=>c.pct));
const ratios = [
  {t:'Margen bruto sobre ventas', v:fmtPct(D.kpi.margen_pct), d:'Ingresos ÷ Ventas. Qué porción de cada peso vendido queda antes de gastos operativos.'},
  {t:'Ratio de rotación (Ventas/Costo)', v:rotacion+'x', d:'Por cada peso de costo de mercadería, cuánto se factura. Más alto es más eficiente.'},
  {t:'Ticket promedio', v:'$'+fmtM(D.kpi.ticket_prom), d:'Venta total ÷ número de transacciones.'},
  {t:'Concentración top cliente', v:fmtPct(topClientePct), d:'Participación del cliente más grande sobre la venta total. Indicador de riesgo de cartera.'},
  {t:'Participación a crédito', v:fmtPct(D.pago.find(p=>p.Pago==='Crédito').Ventas/ventasTotal*100), d:'Proporción de ventas financiadas. Expone la dependencia de la caja al cobro futuro.'},
  {t:'Tendencia mensual de ventas', v:fmtPct(D.tendencia_ventas_pct_mensual), d:'Pendiente de la regresión lineal Ene–Nov como % del promedio mensual.'},
];
document.getElementById('ratiosGrid').innerHTML = ratios.map(r=>`<div class="card"><h3>${r.t}</h3><div class="value" style="font-size:24px;font-weight:700;margin:8px 0;">${r.v}</div><p class="hint" style="margin-bottom:0">${r.d}</p></div>`).join('');

// Gráficos (Chart.js). Envueltos en función propia: si el CDN no cargó a tiempo
// se reintenta un par de veces antes de mostrar un aviso, y un fallo en un
// gráfico no bloquea a los demás.
function pintarGraficos(){
  if (typeof Chart === 'undefined'){
    if (pintarGraficos.intentos === undefined) pintarGraficos.intentos = 0;
    if (pintarGraficos.intentos < 20){
      pintarGraficos.intentos++;
      return setTimeout(pintarGraficos, 250);
    }
    document.querySelectorAll('.chart-box').forEach(el=>{
      el.innerHTML = '<p style="color:var(--ink-faint);font-size:12.5px;padding:12px 0">No se pudo cargar la librería de gráficos (Chart.js) desde el CDN. Verificá la conexión a internet o que cdnjs.cloudflare.com no esté bloqueado.</p>';
    });
    return;
  }

  const mesesLbl = D.meses.map(m=>m.slice(5)+'/'+m.slice(2,4));
  const foreLbl = D.forecast_meses.map(m=>m.slice(5)+'/'+m.slice(2,4));

  const intentar = (fn) => { try { fn(); } catch(e){ console.error('Error al pintar gráfico:', e); } };

  intentar(()=> new Chart(document.getElementById('chartTendencia'), {
    type:'line',
    data:{
      labels:[...mesesLbl, ...foreLbl],
      datasets:[
        {label:'Ventas', data:[...D.ventas_mes, ...Array(3).fill(null)], borderColor:'#e2a63a', backgroundColor:'rgba(226,166,58,.1)', tension:.3, fill:true, pointRadius:3},
        {label:'Ventas (proyección)', data:[...Array(D.ventas_mes.length-1).fill(null), D.ventas_mes[D.ventas_mes.length-1], ...D.forecast_ventas], borderColor:'#e2a63a', borderDash:[5,4], pointRadius:2, fill:false},
        {label:'Margen', data:[...D.ingresos_mes, ...Array(3).fill(null)], borderColor:'#4fb3a6', backgroundColor:'rgba(79,179,166,.08)', tension:.3, fill:true, pointRadius:3},
        {label:'Margen (proyección)', data:[...Array(D.ingresos_mes.length-1).fill(null), D.ingresos_mes[D.ingresos_mes.length-1], ...D.forecast_ingresos], borderColor:'#4fb3a6', borderDash:[5,4], pointRadius:2, fill:false},
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{legend:{labels:{boxWidth:12}, position:'top'}},
      scales:{ y:{ticks:{callback:v=>'$'+fmtM(v)}, grid:{color:'#232833'}}, x:{grid:{display:false}} }
    }
  }));

  intentar(()=> new Chart(document.getElementById('chartTipo'), {
    type:'bar',
    data:{
      labels: D.tipo.map(t=>t.Tipo),
      datasets:[
        {label:'Ventas', data: D.tipo.map(t=>t.Ventas), backgroundColor:'#e2a63a', borderRadius:4},
        {label:'Margen', data: D.tipo.map(t=>t.Ingresos), backgroundColor:'#4fb3a6', borderRadius:4},
      ]
    },
    options:{responsive:true, maintainAspectRatio:false,
      plugins:{legend:{labels:{boxWidth:12}}},
      scales:{ y:{ticks:{callback:v=>'$'+fmtM(v)}, grid:{color:'#232833'}}, x:{grid:{display:false}} }
    }
  }));

  intentar(()=> new Chart(document.getElementById('chartClientes'), {
    type:'doughnut',
    data:{
      labels: D.clientes.map(c=>c.Cliente),
      datasets:[{data: D.clientes.map(c=>c.Ventas), backgroundColor:['#e2a63a','#4fb3a6','#8b8fd8','#d9705f'], borderColor:'#181c24', borderWidth:2}]
    },
    options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'right', labels:{boxWidth:10, font:{size:11.5}}}}}
  }));

  intentar(()=> new Chart(document.getElementById('chartPago'), {
    type:'doughnut',
    data:{
      labels: D.pago.map(p=>p.Pago),
      datasets:[{data: D.pago.map(p=>p.Ventas), backgroundColor:['#4fb3a6','#e2a63a'], borderColor:'#181c24', borderWidth:2}]
    },
    options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'right', labels:{boxWidth:10}}}}
  }));
}
pintarGraficos();
</script>
</body>
</html>
